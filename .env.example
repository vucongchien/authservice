# Server Configuration
NODE_ENV=production
PORT=3000
BASE_URL=http://localhost:3000

# Security & Token Lifetimes
JWT_ISSUER=authservice
JWT_AUDIENCE=authservice-clients
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL_DAYS=14
MAGIC_LINK_TTL_MINUTES=15
DEVICE_CODE_TTL_MINUTES=10
DEVICE_POLL_INTERVAL=5

# Google OAuth 2.1
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Database (Pluggable: SQLite by default or PostgreSQL via DATABASE_URL)
# 1. SQLite (Default local file, zero configuration needed)
DB_PATH=/app/data/authservice.db

# 2. PostgreSQL (Uncomment and set if using Supabase, Neon, AWS RDS, or local Postgres)
# DATABASE_URL=postgres://user:password@localhost:5432/auth_db

# Debug Flag (Set to false in production)
DEBUG_EXPOSE_TOKEN=false
